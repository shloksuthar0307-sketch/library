# ==============================================================================
# ENVIRONMENT SETTINGS (DEV / PROD)
# ==============================================================================
DEBUG=True
SECRET_KEY=replace-with-a-highly-secure-random-string

# Comma-separated list of allowed hostnames (e.g., library.example.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=sqlite:///db.sqlite3

# ==============================================================================
# CELERY / REDIS CONFIGURATION
# ==============================================================================
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/1

# ==============================================================================
# SECURITY (PRODUCTION ONLY)
# ==============================================================================
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
CSRF_TRUSTED_ORIGINS=https://localhost

# ==============================================================================
# EMAIL CONFIGURATION (For Scheduled Reports & Password Resets)
# ==============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production use smtp backend: django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@library.example.com

# ==============================================================================
# RATE LIMITING & BRUTE FORCE (DJANGO AXES)
# ==============================================================================
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1
